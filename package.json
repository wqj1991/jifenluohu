{
  "name": "luohu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "concurrently -n web,api -c cyan,magenta \"vite --mode localapi\" \"node server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "deploy": "node scripts/deploy.mjs",
    "db:pull": "node scripts/deploy.mjs --pull",
    "db:push": "node scripts/push_db.mjs",
    "backup": "node scripts/backup.mjs",
    "build": "tsc -b && vite build",
    "seed": "node server/seed.mjs",
    "auth:reset": "node scripts/set_password.mjs",
    "prices:import": "node scripts/import_prices.mjs",
    "fc:probe": "node scripts/fc/run.mjs probe",
    "fc:fetch": "node scripts/fc/run.mjs fetch",
    "fc:fetch-biz": "node scripts/fc/run.mjs fetch --biz",
    "fc:fetch-5i5j": "node scripts/fc/run.mjs fetch --site 5i5j --slices",
    "fc:weekly": "node scripts/fc/weekly.mjs",
    "fc:import": "node scripts/import_prices.mjs",
    "fc:login": "node scripts/fc/run.mjs login"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-delaunay": "^6.0.4",
    "fastify": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-delaunay": "^6.0.4",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "https-proxy-agent": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
